[Unit]
Description=Agentbox Docker bridges and network policy
Requires=docker.service
After=docker.service
Before=agentbox-broker.service paseo.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/bin/python3 /opt/agentbox/security/network.py --config /etc/agentbox/security.json
UMask=0077

[Install]
WantedBy=multi-user.target
