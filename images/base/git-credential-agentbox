#!/usr/bin/python3
import os
import sys

if len(sys.argv) < 2 or sys.argv[1] != 'get':
    raise SystemExit(0)
fields = dict(line.rstrip('\n').split('=', 1) for line in sys.stdin if '=' in line)
if fields.get('protocol') != 'https' or fields.get('host') != os.environ.get('GITLAB_HOST'):
    raise SystemExit(0)
token = os.environ.get('GITLAB_TOKEN') or os.environ.get('GLAB_TOKEN')
if token:
    print('username=' + os.environ.get('GITLAB_USER', 'oauth2') + '\npassword=' + token + '\n')
